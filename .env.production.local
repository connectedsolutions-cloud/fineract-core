# Production-Like Local Testing Environment Variables
# Copy this file to .env.production.local and customize for local testing
# This file is used by ./gradlew prodLikeRun to test production settings locally
#
# Usage:
#   1. Copy this template: cp env.production.local.template .env.production.local
#   2. Edit .env.production.local with your local database settings
#   3. Run: ./gradlew prodLikeRun
#
# Note: This file should NOT be committed to version control (add to .gitignore)

# ============================================================================
# SPRING PROFILES (Production Settings)
# ============================================================================

# Use production profile (same as production deployment)
SPRING_PROFILES_ACTIVE=production

# ============================================================================
# DATABASE CONFIGURATION (Local Database)
# ============================================================================

# Database connection credentials - adjust for your local database
FINERACT_HIKARI_USERNAME=doadmin
FINERACT_HIKARI_PASSWORD=AVNS_TH6iJht4c3esdO51-iF

# Database connection URL - adjust host/port if needed
# For local MariaDB/MySQL:
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://db-postgresql-nyc3-21477-do-user-13658387-0.d.db.ondigitalocean.com:25060/fineract_tenants

# Database driver
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver

# ============================================================================
# CONNECTION POOL SETTINGS
# ============================================================================

FINERACT_HIKARI_MINIMUM_IDLE=3
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=10
FINERACT_HIKARI_IDLE_TIMEOUT=60000
FINERACT_HIKARI_CONNECTION_TIMEOUT=20000

# ============================================================================
# SSL CONFIGURATION
# ============================================================================

# Enable SSL (same as production)
FINERACT_SERVER_SSL_ENABLED=true

# ============================================================================
# DEFAULT TENANT DATABASE CONFIGURATION
# ============================================================================

# Hostname for default tenant database (localhost for local testing)
FINERACT_DEFAULT_TENANTDB_HOSTNAME=db-postgresql-nyc3-21477-do-user-13658387-0.d.db.ondigitalocean.com
FINERACT_DEFAULT_TENANTDB_NAME=fineract_default
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=default
FINERACT_DEFAULT_TENANTDB_PWD=AVNS_TH6iJht4c3esdO51-iF
FINERACT_DEFAULT_TENANTDB_PORT=25060
FINERACT_DEFAULT_TENANTDB_UID=doadmin
FINERACT_DEFAULT_MASTER_PASSWORD=fineract

# ============================================================================
# PRODUCTION SETTINGS (Same as Production)
# ============================================================================

# Node ID
FINERACT_NODE_ID=1

# IMPORTANT: Disable insecure HTTP client (same as production)
# This is a key difference from dev mode
FINERACT_INSECURE_HTTP_CLIENT=false

# ============================================================================
# JAVA OPTIONS (Production-like, adjust based on your machine)
# ============================================================================

# Production-like memory settings (adjust based on your local machine)
# JAVA_TOOL_OPTIONS=-Xmx2G -Xms2G -XX:+UseContainerSupport -XX:+UseStringDeduplication

# ============================================================================
# MANAGEMENT & MONITORING
# ============================================================================

FINERACT_MANAGEMENT_ENDPOINT_WEB_EXPOSURE_INCLUDE=health,info,prometheus
FINERACT_MANAGEMENT_METRICS_TAGS_APPLICATION=fineract
OTEL_SERVICE_NAME=fineract

# ============================================================================
# USER & GROUP SETTINGS
# ============================================================================

FINERACT_USER=1000
FINERACT_GROUP=1000

# ============================================================================
# CUSTOM ENVIRONMENT VARIABLES
# ============================================================================

# Add your custom environment variables here (same as production):
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2

MH_VALIDATION_BASE_URL: "http://firma:8113/firma" # or localhost URL if external
MH_VALIDATION_PATH: "/validardocumento/?sync=false"
MH_WEBHOOK_SHARED_SECRET: "$dewdeASASA45DSA7DS4"