{
  "version": 1,
  "id": "local-full-resync",
  "description": "Checkpointed local sandbox re-sync for all 16 services using reviewed deltas without restoring the tenant or replaying unchanged history.",
  "targets": ["local"],
  "run_modes": ["full-resync"],
  "services": [
    "clients",
    "employees",
    "client-staff-assignments",
    "client-pep",
    "client-family-references",
    "client-personal-family-references",
    "membership-share-capital",
    "savings-deposits",
    "savings-account-parties",
    "native-share-capital",
    "aml-alerts",
    "loans",
    "dte-history",
    "mobile-collections",
    "accounting-journal-entries",
    "native-share-yield"
  ],
  "ordering": "registry-topological",
  "scope": {"mode": "full-block"},
  "stop_policy": "dependency-gated",
  "retry_policy": "resume-failed-step",
  "accounting_cutoff_policy": "snapshot-only",
  "target_prerequisites": {
    "financial_activity_mappings": [
      {
        "required_by_services": ["loans"],
        "financial_activity_id": 100,
        "gl_code": "1510",
        "gl_classification": 1,
        "gl_usage": 1
      },
      {
        "required_by_services": ["savings-deposits"],
        "financial_activity_id": 200,
        "gl_code": "2130050101",
        "gl_classification": 2,
        "gl_usage": 1
      }
    ]
  },
  "unavailable_services": "reject"
}
