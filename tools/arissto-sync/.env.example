# Read-only Arissto SQL Server account
ARISSTO_SERVER=
ARISSTO_PORT=1433
ARISSTO_DATABASE=
ARISSTO_USER=
ARISSTO_PASSWORD=
ARISSTO_ODBC_DRIVER=ODBC Driver 18 for SQL Server
ARISSTO_ODBC_EXTRA=Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly
ARISSTO_CONNECT_TIMEOUT=15
ARISSTO_QUERY_TIMEOUT=30

# Local Fineract API and optional PostgreSQL inspection/direct-SQL connection
FINERACT_LOCAL_API_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_LOCAL_API_USER=mifos
FINERACT_LOCAL_API_PASSWORD=password
FINERACT_LOCAL_TENANT=sandbox
FINERACT_LOCAL_PG_URL=postgresql://postgres:PASSWORD@localhost:5432/fineract_sandbox
FINERACT_LOCAL_EXPECTED_HOST=localhost
FINERACT_LOCAL_TLS_VERIFY=false

# Production (leave unset until local validation is complete)
FINERACT_PROD_API_URL=
FINERACT_PROD_API_USER=
FINERACT_PROD_API_PASSWORD=
FINERACT_PROD_TENANT=default
FINERACT_PROD_PG_URL=
FINERACT_PROD_EXPECTED_HOST=
FINERACT_PROD_TLS_VERIFY=true

ARISSTO_SYNC_STATE=.arissto-sync/state.sqlite3
ARISSTO_SYNC_CLIENT_MAPPING=config/clients.json
ARISSTO_SYNC_CLIENT_PEP_MAPPING=config/client_pep.json
ARISSTO_SYNC_FAMILY_REFERENCE_MAPPING=config/client_family_references.json
ARISSTO_SYNC_EMPLOYEE_MAPPING=config/employees.json
# Loan worker defaults used by direct apply/retry and frozen into new workflow plans.
ARISSTO_SYNC_LOAN_WORKERS=2
ARISSTO_SYNC_FINERACT_PAUSE_SECONDS=30
ARISSTO_SYNC_DTE_WORKERS=2
ARISSTO_SYNC_DTE_BATCH_SIZE=500
ARISSTO_SYNC_FINERACT_RECOVERY_ATTEMPTS=3
# Local workflow-only process recovery. The command is parsed as arguments and
# executed without a shell from the fineract-core directory.
ARISSTO_SYNC_FINERACT_RESTART_ATTEMPTS=1
ARISSTO_SYNC_FINERACT_RESTART_TIMEOUT_SECONDS=180
ARISSTO_SYNC_FINERACT_RESTART_POLL_SECONDS=5
ARISSTO_SYNC_FINERACT_RESTART_COMMAND="./scripts/local-fineract.sh restart"
# Optional fresh-cycle baseline reset. The guarded reset still requires a
# disposable non-default tenant and exact TENANT:DATABASE confirmation.
ARISSTO_SYNC_FINERACT_STOP_COMMAND="./scripts/local-fineract.sh stop"
ARISSTO_SYNC_FINERACT_RESET_TIMEOUT_SECONDS=900
# Deprecated fallback; prefer the target-specific FINERACT_*_TLS_VERIFY values.
ARISSTO_SYNC_TLS_VERIFY=true
