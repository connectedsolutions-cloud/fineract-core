{
  "version": 1,
  "services": [
    {
      "id": "clients",
      "name": "Clients",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "clients",
      "depends_on": [],
      "post_sync_services": ["client-pep", "client-family-references"],
      "description": "Migrates reviewed AFI_SOCIO natural-person identity and non-PEP KYC/profile data into Fineract core client fields, identifiers, and Credesal datatables, including plain-text home/work addresses; products are excluded.",
      "documentation": "migration-services/clients/README.md",
      "detail_documents": [
        "migration-services/clients/contract.md",
        "migration-services/client-system-codes/contract.md"
      ],
      "configuration": "config/clients.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block clients --target TARGET",
        "plan": "./arissto-sync plan --block clients --target TARGET --source-key NUMERO_AFILIACION",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "apply_with_pep": "./arissto-sync apply --plan PLAN_ID --target TARGET --with-pep",
        "apply_with_family_references": "./arissto-sync apply --plan PLAN_ID --target TARGET --with-family-references",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block clients --target TARGET"
      }
    },
    {
      "id": "client-pep",
      "name": "Client PEP",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "client-pep",
      "depends_on": ["clients"],
      "trigger": {
        "after": "clients",
        "condition": "successful-client-reconciliation",
        "command": "./arissto-sync apply --plan CLIENT_PLAN_ID --target TARGET --with-pep"
      },
      "description": "Synchronizes the verified AFI_SOCIO direct PEP flag into credesal_client_pep only after the parent Fineract client exists and the scoped clients run reconciles successfully.",
      "documentation": "migration-services/client-pep/README.md",
      "detail_documents": ["migration-services/client-pep/contract.md"],
      "configuration": "config/client_pep.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block client-pep --target TARGET",
        "plan": "./arissto-sync plan --block client-pep --target TARGET --source-key NUMERO_AFILIACION",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "apply_after_clients": "./arissto-sync apply --plan CLIENT_PLAN_ID --target TARGET --with-pep",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block client-pep --target TARGET"
      }
    },
    {
      "id": "client-family-references",
      "name": "Client family references",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "client-family-references",
      "depends_on": ["clients"],
      "description": "Synchronizes AFI_REF_FAMILIAR_SOCIO personal/family references for both Arissto CLIENTE and SOCIO parties into Fineract family members, with durable source identity, API-only writes, retry, and exact reconciliation; it can run independently or as an opt-in dependent step of client apply.",
      "documentation": "migration-services/client-family-references/README.md",
      "detail_documents": ["migration-services/client-family-references/contract.md"],
      "configuration": "config/client_family_references.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block client-family-references --target TARGET",
        "plan": "./arissto-sync plan --block client-family-references --target TARGET --source-key NUMERO_AFILIACION:ID_REF_FAM",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "apply_after_clients": "./arissto-sync apply --plan CLIENT_PLAN_ID --target TARGET --with-family-references",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block client-family-references --target TARGET"
      }
    },
    {
      "id": "employees",
      "name": "Employees",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "employees",
      "depends_on": [],
      "description": "Synchronizes the complete PERSONAS_EMPRESA profile into Fineract staff core plus credesal_staff_profile, including contact and sensitive HR data; app-user creation, credentials, permissions, and client/loan assignments remain separate.",
      "documentation": "migration-services/employees/README.md",
      "detail_documents": ["migration-services/employees/contract.md"],
      "configuration": "config/employees.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block employees --target TARGET",
        "plan": "./arissto-sync plan --block employees --target TARGET --source-key ID_EMPRESA:ID_PERSONA",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block employees --target TARGET"
      }
    },
    {
      "id": "client-staff-assignments",
      "name": "Client staff assignments",
      "kind": "sync-block",
      "status": "blocked",
      "executable": true,
      "cli_block": "client-staff-assignments",
      "depends_on": ["clients", "employees"],
      "description": "Synchronizes AFI_SOCIO promoter, account-executive, and collections-manager relationships independently into a lossless one-to-one Fineract client extension after both clients and employees exist. It does not derive or modify Fineract's native loan-officer field. A controlled local apply, exact reconciliation, and unchanged replay of the revised contract are pending.",
      "documentation": "migration-services/client-staff-assignments/README.md",
      "detail_documents": ["migration-services/client-staff-assignments/contract.md"],
      "configuration": "config/client_staff_assignments.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block client-staff-assignments --target TARGET",
        "plan": "./arissto-sync plan --block client-staff-assignments --target TARGET --source-key NUMERO_AFILIACION",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block client-staff-assignments --target TARGET"
      }
    },
    {
      "id": "membership-share-capital",
      "name": "Membership and share capital",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "membership-share-capital",
      "depends_on": ["clients"],
      "description": "Preserves reviewed cooperative membership, share, certificate, contribution, dividend, governance, and current-party operational records in versioned Fineract extension tables; the narrowed current-party scope is locally reconciled and idempotent, while native financial shares remain isolated in the separately gated native-share-capital service.",
      "documentation": "migration-services/membership-share-capital/README.md",
      "detail_documents": [
        "migration-services/membership-share-capital/contract.md",
        "migration-services/membership-share-capital/lifecycle.md",
        "migration-services/membership-share-capital/implementation-sequence.md"
      ],
      "configuration": "config/membership_share_capital.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block membership-share-capital --target TARGET",
        "plan": "./arissto-sync plan --block membership-share-capital --target TARGET --source-key 'SOURCE_TABLE|COMPOSITE_KEY'",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block membership-share-capital --target TARGET"
      }
    },
    {
      "id": "savings-deposits",
      "name": "Savings and fixed-term deposits",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "savings-deposits",
      "depends_on": ["clients"],
      "description": "Migrates Arissto VISTA savings and PLAZO fixed-term deposits into native Fineract products, accounts, transactions, interest/accrual, tax, transfer, closure, and accounting lifecycles; the deterministic plan/apply/retry/reconcile engine is locally accepted for all 157 source accounts, with 155 reconciled native positions and 2 reviewed zero-principal placeholders quarantined.",
      "documentation": "migration-services/savings-deposits/README.md",
      "detail_documents": [
        "migration-services/savings-deposits/contract.md",
        "migration-services/savings-deposits/implementation-sequence.md"
      ],
      "configuration": "config/savings_deposits.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block savings-deposits --target TARGET",
        "plan": "./arissto-sync plan --block savings-deposits --target TARGET",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block savings-deposits --target TARGET"
      }
    },
    {
      "id": "native-share-capital",
      "name": "Native share capital",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "native-share-capital",
      "depends_on": ["clients", "membership-share-capital", "savings-deposits"],
      "description": "Projects reviewed paid common and preferred positions into native Fineract products, accounts, purchases, accounting, and certificate extensions through deterministic plan/apply/retry/reconcile workflows; the payment-channel schema/API support and controlled lifecycle acceptance have passed locally, while positions without an eligible same-client VISTA account remain explicit quarantines.",
      "documentation": "migration-services/native-share-capital/README.md",
      "detail_documents": [
        "migration-services/membership-share-capital/lifecycle.md",
        "migration-services/membership-share-capital/implementation-sequence.md"
      ],
      "configuration": "config/native_share_capital.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block native-share-capital --target TARGET [--source-key 'AFI_ACCION|ID']",
        "plan": "./arissto-sync plan --block native-share-capital --target TARGET [--source-key 'AFI_ACCION|ID']",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "retry": "./arissto-sync retry --run RUN_ID --failed-only --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block native-share-capital --target TARGET"
      }
    },
    {
      "id": "aml-alerts",
      "name": "AML alerts",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "aml-alerts",
      "depends_on": ["clients"],
      "description": "Plans lossless migration of Arissto AML/LAFT subtype 69 and 70 alert headers, client or membership-role subjects, and related movement references into the versioned Credesal AML domain tables; runtime rule evaluation and case workflows are deferred.",
      "documentation": "migration-services/aml-alerts/README.md",
      "detail_documents": ["migration-services/aml-alerts/contract.md"],
      "configuration": "config/aml_alerts.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block aml-alerts --target TARGET",
        "plan": "./arissto-sync plan --block aml-alerts --target TARGET --source-key ID_EVENTO",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block aml-alerts --target TARGET"
      }
    },
    {
      "id": "loans",
      "name": "Loans",
      "kind": "sync-block",
      "status": "blocked",
      "executable": true,
      "cli_block": "loans",
      "depends_on": [
        "clients",
        "employees"
      ],
      "post_sync_services": [
        "mobile-collections"
      ],
      "description": "Implements reviewed Arissto loan products and native loan lifecycles, including source-exact schedules and transaction allocations, reversals, Cobro Movil payment routing, terminal cutover adjustments, single-loan refinancing, multi-loan consolidation pending its financial canary and replay, and independent per-loan promoter, account-executive, and collections-manager assignments. Native loan officer remains optional. Gate 5 remains open for schedule/API edge cases, a clean full supported-population reconciliation, and unchanged replay.",
      "documentation": "migration-services/loans/README.md",
      "detail_documents": [
        "migration-services/loans/contract.md",
        "migration-services/loans/implementation-sequence.md"
      ],
      "configuration": "config/loans.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block loans [--target TARGET] [--source-key ID_CREDITO]",
        "plan": "./arissto-sync plan --block loans --target TARGET [--source-key ID_CREDITO]",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "retry": "./arissto-sync retry --run RUN_ID --failed-only --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block loans --target TARGET",
        "schedule_proof": "./arissto-sync prove-loan-schedule --target local --source-key ID_CREDITO --product-id PRODUCT_ID --client-id CLIENT_ID"
      }
    },
    {
      "id": "mobile-collections",
      "name": "Mobile collections",
      "kind": "sync-block",
      "status": "available",
      "executable": true,
      "cli_block": "mobile-collections",
      "depends_on": [
        "clients",
        "employees",
        "savings-deposits",
        "loans"
      ],
      "description": "Preserves Arissto Cobro Movil routes, assignments, routed accounts, daily batches, receipts, capture/application timestamps, and deterministic links to native accounts and repayments without creating financial transactions. The metadata engine reconciles locally with six missing-client records quarantined and an idempotent zero-write second plan, but that acceptance used partial native loan and repayment coverage. Final end-to-end repayment-link acceptance remains downstream of a clean full Loans reconciliation on the same target.",
      "documentation": "migration-services/mobile-collections/README.md",
      "detail_documents": [
        "migration-services/mobile-collections/contract.md",
        "migration-services/mobile-collections/implementation-sequence.md"
      ],
      "configuration": "config/mobile_collections.json",
      "commands": {
        "inspect": "./arissto-sync inspect --block mobile-collections --target TARGET",
        "plan": "./arissto-sync plan --block mobile-collections --target TARGET",
        "apply": "./arissto-sync apply --plan PLAN_ID --target TARGET",
        "retry": "./arissto-sync retry --run RUN_ID --failed-only --target TARGET",
        "reconcile": "./arissto-sync reconcile --run RUN_ID --target TARGET",
        "status": "./arissto-sync status --block mobile-collections --target TARGET"
      }
    },
    {
      "id": "accounting-journal-entries",
      "name": "Accounting journal entries",
      "kind": "sync-block",
      "status": "planned",
      "executable": false,
      "depends_on": [],
      "description": "Planned migration of reviewed Arissto general-ledger journal headers and debit/credit lines into Fineract journal entries, preserving the exact monthly Arissto journal number in ref_num while preventing duplicate accounting already generated by native product migrations.",
      "documentation": "migration-services/accounting-journal-entries/README.md",
      "detail_documents": [
        "migration-services/accounting-journal-entries/contract.md"
      ]
    }
  ]
}
