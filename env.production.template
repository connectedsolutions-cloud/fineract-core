# Fineract-Core Production Environment Variables Template
# Copy this file to your Digital Ocean droplet as .env and customize the values
# Location: /opt/credesal/fineract/.env
# Security: chmod 600 .env

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database connection credentials
FINERACT_HIKARI_USERNAME=root
FINERACT_HIKARI_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Database connection URL
# For MariaDB/MySQL: jdbc:mariadb://db:3306/fineract_tenants?useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&sessionVariables=time_zone='-00:00'
# For PostgreSQL: jdbc:postgresql://db:5432/fineract_tenants
FINERACT_HIKARI_DS_URL=jdbc:mariadb://db:3306/fineract_tenants?useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&sessionVariables=time_zone='-00:00'

# Database driver class name
# For MariaDB: org.mariadb.jdbc.Driver
# For MySQL: com.mysql.cj.jdbc.Driver
# For PostgreSQL: org.postgresql.Driver
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.mariadb.jdbc.Driver

# ============================================================================
# CONNECTION POOL SETTINGS
# ============================================================================

FINERACT_HIKARI_MINIMUM_IDLE=3
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=10
FINERACT_HIKARI_IDLE_TIMEOUT=60000
FINERACT_HIKARI_CONNECTION_TIMEOUT=20000

# ============================================================================
# SSL CONFIGURATION
# ============================================================================

# Enable SSL for the Fineract server (true for production)
FINERACT_SERVER_SSL_ENABLED=true

# ============================================================================
# DEFAULT TENANT DATABASE CONFIGURATION
# ============================================================================

# Hostname where the default tenant database is located
FINERACT_DEFAULT_TENANTDB_HOSTNAME=db

# Database name for the default tenant
FINERACT_DEFAULT_TENANTDB_NAME=fineract_default

# Tenant identifier
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=default

# Password for the default tenant database
FINERACT_DEFAULT_TENANTDB_PWD=CHANGE_ME_TENANT_PASSWORD_HERE

# Master password for Fineract
FINERACT_DEFAULT_MASTER_PASSWORD=fineract

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Spring profiles: use 'production' for production, 'test,diagnostics' for development
SPRING_PROFILES_ACTIVE=production

# Node ID for clustering (use unique ID for each node in a cluster)
FINERACT_NODE_ID=1

# Disable insecure HTTP client in production
FINERACT_INSECURE_HTTP_CLIENT=false

# ============================================================================
# JAVA OPTIONS
# ============================================================================

# Adjust memory settings based on your droplet's RAM:
# - 2GB RAM droplet: -Xmx1G -Xms1G
# - 4GB RAM droplet: -Xmx2G -Xms2G
# - 8GB RAM droplet: -Xmx4G -Xms4G
JAVA_TOOL_OPTIONS=-Xmx2G -Xms2G -XX:+UseContainerSupport -XX:+UseStringDeduplication

# ============================================================================
# MANAGEMENT & MONITORING
# ============================================================================

# Management endpoints to expose
FINERACT_MANAGEMENT_ENDPOINT_WEB_EXPOSURE_INCLUDE=health,info,prometheus

# Metrics tags
FINERACT_MANAGEMENT_METRICS_TAGS_APPLICATION=fineract

# OpenTelemetry service name
OTEL_SERVICE_NAME=fineract

# ============================================================================
# USER & GROUP SETTINGS
# ============================================================================

FINERACT_USER=1000
FINERACT_GROUP=1000

# ============================================================================
# CUSTOM ENVIRONMENT VARIABLES
# ============================================================================

# Add your custom environment variables below:
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2
# CUSTOM_VAR_3=value3

# ============================================================================
# DOCKER REGISTRY CONFIGURATION (if using Digital Ocean registry)
# ============================================================================

# REGISTRY=registry.digitalocean.com
# REGISTRY_NAME=credesal
# VERSION_TAG=latest


