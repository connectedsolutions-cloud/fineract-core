<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0305-1-nullable-arissto-route-identity" author="credesal">
        <dropNotNullConstraint tableName="credesal_mobile_collection_route" columnName="arissto_route_id" columnDataType="INT"/>
        <dropNotNullConstraint tableName="credesal_mobile_collection_assignment" columnName="arissto_assignment_id" columnDataType="BIGINT"/>
        <dropNotNullConstraint tableName="credesal_mobile_collection_assignment" columnName="arissto_associate_id" columnDataType="INT"/>
    </changeSet>

    <changeSet id="0305-2-unique-route-client" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM (
                    SELECT route_id, client_id
                    FROM credesal_mobile_collection_assignment
                    GROUP BY route_id, client_id
                    HAVING COUNT(1) &gt; 1
                ) duplicates
            </sqlCheck>
        </preConditions>
        <addUniqueConstraint tableName="credesal_mobile_collection_assignment" columnNames="route_id,client_id"
                              constraintName="UK_cr_mc_assign_route_client"/>
    </changeSet>

    <changeSet id="0305-3-permissions" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_MOBILECOLLECTIONROUTE'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="READ_MOBILECOLLECTIONROUTE"/>
            <column name="entity_name" value="MOBILECOLLECTIONROUTE"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_MOBILECOLLECTIONROUTE"/>
            <column name="entity_name" value="MOBILECOLLECTIONROUTE"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="UPDATE_MOBILECOLLECTIONROUTE"/>
            <column name="entity_name" value="MOBILECOLLECTIONROUTE"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="DELETE_MOBILECOLLECTIONROUTE"/>
            <column name="entity_name" value="MOBILECOLLECTIONROUTE"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
