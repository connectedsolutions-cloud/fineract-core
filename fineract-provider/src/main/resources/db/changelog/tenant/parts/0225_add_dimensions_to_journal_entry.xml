<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Add dimensions column to acc_gl_journal_entry for PostgreSQL -->
    <changeSet author="fineract" id="add-dimensions-postgresql" context="postgresql">
        <addColumn tableName="acc_gl_journal_entry">
            <column name="dimensions" type="JSONB">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add dimensions column to acc_gl_journal_entry for MySQL -->
    <changeSet author="fineract" id="add-dimensions-mysql" context="mysql">
        <addColumn tableName="acc_gl_journal_entry">
            <column name="dimensions" type="JSON">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Create GIN index on dimensions column for PostgreSQL (for efficient querying) -->
    <changeSet author="fineract" id="create-dimensions-gin-index" runInTransaction="false" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_indexes WHERE tablename='acc_gl_journal_entry' AND indexname='idx_acc_gl_journal_entry_dimensions_gin';
            </sqlCheck>
        </preConditions>
        <sql>
            CREATE INDEX CONCURRENTLY idx_acc_gl_journal_entry_dimensions_gin ON acc_gl_journal_entry USING GIN (dimensions);
        </sql>
    </changeSet>

</databaseChangeLog>
