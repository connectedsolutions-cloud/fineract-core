<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0252-1-mysql" author="fineract" context="mysql">
        <createTable tableName="m_invoice">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_transaction_id" type="BIGINT"/>
            <column name="savings_transaction_id" type="BIGINT"/>
            <column name="client_transaction_id" type="BIGINT"/>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ambiente" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_dte" type="VARCHAR(4)">
                <constraints nullable="false"/>
            </column>
            <column name="numero_control" type="VARCHAR(31)">
                <constraints nullable="false"/>
            </column>
            <column name="codigo_generacion" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_modelo" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_operacion" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="fec_emi" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="hor_emi" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_moneda" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_contingencia" type="INT"/>
            <column name="motivo_contin" type="VARCHAR(255)"/>
            <column name="firma_electronica" type="LONGTEXT"/>
            <column name="sello_recibido" type="VARCHAR(40)"/>
            <column name="authority_status" type="VARCHAR(40)"/>
            <column name="authority_message" type="TEXT"/>
            <column name="authority_processed_at" type="DATETIME(6)"/>
            <column name="createdby_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodifiedby_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodified_date" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="m_invoice" baseColumnNames="loan_transaction_id"
                                 constraintName="fk_invoice_loan_transaction"
                                 referencedTableName="m_loan_transaction" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_invoice" baseColumnNames="savings_transaction_id"
                                 constraintName="fk_invoice_savings_transaction"
                                 referencedTableName="m_savings_account_transaction" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_invoice" baseColumnNames="client_transaction_id"
                                 constraintName="fk_invoice_client_transaction"
                                 referencedTableName="m_client_transaction" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_invoice" baseColumnNames="createdby_id"
                                 constraintName="fk_invoice_createdby"
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_invoice" baseColumnNames="lastmodifiedby_id"
                                 constraintName="fk_invoice_lastmodifiedby"
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>

        <addUniqueConstraint tableName="m_invoice" columnNames="codigo_generacion" constraintName="uk_invoice_codigo_generacion"/>
        <addUniqueConstraint tableName="m_invoice" columnNames="numero_control" constraintName="uk_invoice_numero_control"/>

        <createIndex indexName="idx_invoice_status" tableName="m_invoice">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_invoice_fec_emi" tableName="m_invoice">
            <column name="fec_emi"/>
        </createIndex>
        <createIndex indexName="idx_invoice_ambiente" tableName="m_invoice">
            <column name="ambiente"/>
        </createIndex>
        <createIndex indexName="idx_invoice_loan_tx" tableName="m_invoice">
            <column name="loan_transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_invoice_savings_tx" tableName="m_invoice">
            <column name="savings_transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_invoice_client_tx" tableName="m_invoice">
            <column name="client_transaction_id"/>
        </createIndex>
    </changeSet>

