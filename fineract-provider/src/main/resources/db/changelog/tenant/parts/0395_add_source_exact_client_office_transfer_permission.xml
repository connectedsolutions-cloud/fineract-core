<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="0395-1-add-source-exact-client-office-transfer-permission" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'SOURCEEXACTPROPOSEANDACCEPTTRANSFER_CLIENT'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="SOURCEEXACTPROPOSEANDACCEPTTRANSFER_CLIENT"/>
            <column name="entity_name" value="CLIENT"/>
            <column name="action_name" value="SOURCEEXACTPROPOSEANDACCEPTTRANSFER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
