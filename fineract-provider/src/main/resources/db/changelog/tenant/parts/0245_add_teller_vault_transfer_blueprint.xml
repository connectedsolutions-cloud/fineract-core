<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Insert teller-vault-transfer blueprint (cashier requests transfer to vault for manager approval) -->
    <changeSet id="0245-add-teller-vault-transfer-blueprint" author="fineract">
        <validCheckSum>9:614148fef0ca0274c057ac008cfa5112</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_pending_flow_blueprint WHERE name = 'teller-vault-transfer'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_pending_flow_blueprint">
            <column name="status" value="active"/>
            <column name="name" value="teller-vault-transfer"/>
            <column name="version" value="1.0"/>
            <column name="last_step_name" value="approve_cash_transfer"/>
            <column name="steps" value='[{"order":1,"name":"approve_cash_transfer","description":"Approve cash transfer to vault","reference_type":"request","reference_fields":[{"key":"cashierId","type":"long","description":"Cashier who requested the transfer"},{"key":"responsable_user","type":"long","description":"User responsible for approving"},{"key":"amount","type":"string","description":"Amount to transfer (decimal as string)"},{"key":"currencyCode","type":"string","description":"Currency code e.g. MXN"}]}]'/>
        </insert>
    </changeSet>

</databaseChangeLog>
