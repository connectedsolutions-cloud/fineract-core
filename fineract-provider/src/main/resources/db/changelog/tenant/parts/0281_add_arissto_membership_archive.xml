<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0281-1-create-membership-archive" author="credesal">
        <createTable tableName="credesal_arissto_membership_record">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="source_table" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="source_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT"/>
            <column name="record_kind" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_source_key" type="VARCHAR(500)"/>
            <column name="effective_date" type="DATE"/>
            <column name="source_payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="source_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="credesal_arissto_membership_record"
                             columnNames="source_table,source_key"
                             constraintName="UK_credesal_arissto_membership_source"/>
        <addForeignKeyConstraint baseTableName="credesal_arissto_membership_record"
                                 baseColumnNames="client_id"
                                 constraintName="FK_credesal_arissto_membership_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <createIndex tableName="credesal_arissto_membership_record"
                     indexName="IX_credesal_arissto_membership_client">
            <column name="client_id"/>
        </createIndex>
        <createIndex tableName="credesal_arissto_membership_record"
                     indexName="IX_credesal_arissto_membership_kind">
            <column name="record_kind"/>
        </createIndex>
    </changeSet>

    <changeSet id="0281-2-create-member-profile" author="credesal">
        <createTable tableName="credesal_member_profile">
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="arissto_associate_id" type="INT"/>
            <column name="arissto_company_id" type="VARCHAR(3)"/>
            <column name="arissto_branch_id" type="VARCHAR(3)"/>
            <column name="arissto_member_id" type="VARCHAR(10)"/>
            <column name="affiliation_number" type="VARCHAR(25)"/>
            <column name="relationship_state_id" type="VARCHAR(3)"/>
            <column name="relationship_state" type="VARCHAR(50)"/>
            <column name="lifecycle_status_id" type="VARCHAR(3)"/>
            <column name="lifecycle_status" type="VARCHAR(50)"/>
            <column name="request_date" type="DATE"/>
            <column name="initial_entry_date" type="DATE"/>
            <column name="entry_date" type="DATE"/>
            <column name="entry_approval_date" type="DATE"/>
            <column name="entry_reason" type="TEXT"/>
            <column name="withdrawal_approval_date" type="DATE"/>
            <column name="withdrawal_date" type="DATE"/>
            <column name="withdrawal_reason" type="TEXT"/>
            <column name="entry_type" type="VARCHAR(1)"/>
            <column name="common_share_count" type="DECIMAL(18,2)"/>
            <column name="common_share_balance" type="DECIMAL(19,2)"/>
            <column name="preferred_share_count" type="DECIMAL(18,2)"/>
            <column name="preferred_share_balance" type="DECIMAL(19,2)"/>
            <column name="subscribed_share_count" type="DECIMAL(18,2)"/>
            <column name="subscribed_share_balance" type="DECIMAL(19,2)"/>
            <column name="paid_share_count" type="DECIMAL(18,2)"/>
            <column name="paid_share_balance" type="DECIMAL(19,2)"/>
            <column name="certificate_count" type="INT"/>
            <column name="contribution_movement_count" type="INT"/>
            <column name="contribution_amount" type="DECIMAL(19,2)"/>
            <column name="last_contribution_date" type="DATE"/>
            <column name="source_hash" type="VARCHAR(64)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="credesal_member_profile"
                             columnNames="arissto_associate_id"
                             constraintName="UK_credesal_member_profile_associate"/>
        <addForeignKeyConstraint baseTableName="credesal_member_profile"
                                 baseColumnNames="client_id"
                                 constraintName="FK_credesal_member_profile_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet id="0281-3-register-member-profile" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM x_registered_table WHERE registered_table_name = 'credesal_member_profile'</sqlCheck>
        </preConditions>
        <insert tableName="x_registered_table">
            <column name="registered_table_name" value="credesal_member_profile"/>
            <column name="application_table_name" value="m_client"/>
            <column name="entity_subtype" value="Person"/>
            <column name="category" valueNumeric="100"/>
        </insert>
    </changeSet>

    <changeSet id="0281-4-member-profile-permissions" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'CREATE_credesal_member_profile'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="CREATE_credesal_member_profile"/><column name="entity_name" value="credesal_member_profile"/><column name="action_name" value="CREATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="READ_credesal_member_profile"/><column name="entity_name" value="credesal_member_profile"/><column name="action_name" value="READ"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="UPDATE_credesal_member_profile"/><column name="entity_name" value="credesal_member_profile"/><column name="action_name" value="UPDATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="DELETE_credesal_member_profile"/><column name="entity_name" value="credesal_member_profile"/><column name="action_name" value="DELETE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    </changeSet>

</databaseChangeLog>
