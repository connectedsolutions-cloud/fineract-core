<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="0402-1-create-gl-auxiliar-catalog" author="credesal">
        <createTable tableName="credesal_gl_auxiliar">
            <column name="code" type="VARCHAR(32)">
                <constraints primaryKey="true" primaryKeyName="pk_cr_gl_auxiliar" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="manual_allowed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="historical_arissto_code" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <!-- Exact observed Arissto options are approved for explicit manual choice. Automatic route assignments remain unapproved. -->
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="0"/><column name="name" value="PRINCIPAL"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="1"/><column name="name" value="CONTABILIDAD"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="3"/><column name="name" value="CAJA"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="4"/><column name="name" value="CREDITOS"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="5"/><column name="name" value="AHORROS-DEPOSITOS"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="12"/><column name="name" value="OPERACIONES INTERNAS"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="14"/><column name="name" value="COBRO MÓVIL"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="20"/><column name="name" value="BOVEDA"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="22"/><column name="name" value="INVERSIONES"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
        <insert tableName="credesal_gl_auxiliar"><column name="code" value="25"/><column name="name" value="OPERACIONES CONTABLES"/><column name="manual_allowed" valueBoolean="true"/><column name="historical_arissto_code" valueBoolean="true"/></insert>
    </changeSet>

    <changeSet id="0402-2-create-gl-voucher" author="credesal">
        <createTable tableName="credesal_gl_voucher">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_cr_gl_voucher" nullable="false"/>
            </column>
            <column name="auxiliar_code" type="VARCHAR(32)"/>
            <column name="auxiliar_rule_version" type="VARCHAR(32)"/>
            <column name="header_concept" type="TEXT"/>
            <column name="origin" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="operation_type" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="source_entity_type" type="VARCHAR(80)"/>
            <column name="source_entity_id" type="VARCHAR(80)"/>
            <column name="reverses_voucher_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_gl_voucher" baseColumnNames="auxiliar_code"
                                 referencedTableName="credesal_gl_auxiliar" referencedColumnNames="code"
                                 constraintName="fk_cr_gl_voucher_auxiliar" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_gl_voucher" baseColumnNames="reverses_voucher_id"
                                 referencedTableName="credesal_gl_voucher" referencedColumnNames="id"
                                 constraintName="fk_cr_gl_voucher_reversal" onDelete="RESTRICT"/>
        <createIndex tableName="credesal_gl_voucher" indexName="ix_cr_gl_voucher_auxiliar">
            <column name="auxiliar_code"/>
        </createIndex>
        <addColumn tableName="acc_gl_journal_entry">
            <column name="voucher_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="acc_gl_journal_entry" baseColumnNames="voucher_id"
                                 referencedTableName="credesal_gl_voucher" referencedColumnNames="id"
                                 constraintName="fk_gl_journal_entry_voucher" onDelete="RESTRICT"/>
        <createIndex tableName="acc_gl_journal_entry" indexName="ix_gl_journal_entry_voucher">
            <column name="voucher_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
