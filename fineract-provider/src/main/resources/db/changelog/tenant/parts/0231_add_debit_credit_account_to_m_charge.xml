<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Add debit_account_id and credit_account_id columns to m_charge table -->
    <changeSet id="1" author="fineract">
        <addColumn tableName="m_charge">
            <column name="debit_account_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="fineract">
        <addColumn tableName="m_charge">
            <column name="credit_account_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add foreign key constraints for debit_account_id and credit_account_id -->
    <changeSet id="3" author="fineract">
        <addForeignKeyConstraint baseTableName="m_charge" baseColumnNames="debit_account_id"
                                 constraintName="fk_m_charge_debit_gl_account"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_charge" baseColumnNames="credit_account_id"
                                 constraintName="fk_m_charge_credit_gl_account"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
