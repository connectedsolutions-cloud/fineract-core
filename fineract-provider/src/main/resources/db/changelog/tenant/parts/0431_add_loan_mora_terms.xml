<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="0431-1-create-loan-mora-terms" author="credesal">
        <createTable tableName="credesal_loan_mora_terms">
            <column name="loan_id" type="BIGINT"><constraints nullable="false" primaryKey="true"/></column>
            <column name="monthly_rate_percent" type="DECIMAL(8,2)"><constraints nullable="false"/></column>
            <column name="grace_days" type="INTEGER"><constraints nullable="false"/></column>
            <column name="last_source_mora_payment_on" type="DATE"/>
            <column name="fineract_starts_on" type="DATE"><constraints nullable="false"/></column>
            <column name="source_mora_balance" type="DECIMAL(12,2)"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_loan_mora_terms" baseColumnNames="loan_id"
                                 constraintName="FK_credesal_loan_mora_terms_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>
    <changeSet id="0431-2-register-loan-mora-terms" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM x_registered_table WHERE registered_table_name = 'credesal_loan_mora_terms'</sqlCheck>
        </preConditions>
        <insert tableName="x_registered_table">
            <column name="registered_table_name" value="credesal_loan_mora_terms"/>
            <column name="application_table_name" value="m_loan"/>
            <column name="category" valueNumeric="100"/>
        </insert>
    </changeSet>
    <changeSet id="0431-3-loan-mora-terms-permissions" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'CREATE_credesal_loan_mora_terms'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="CREATE_credesal_loan_mora_terms"/><column name="entity_name" value="credesal_loan_mora_terms"/><column name="action_name" value="CREATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="READ_credesal_loan_mora_terms"/><column name="entity_name" value="credesal_loan_mora_terms"/><column name="action_name" value="READ"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="UPDATE_credesal_loan_mora_terms"/><column name="entity_name" value="credesal_loan_mora_terms"/><column name="action_name" value="UPDATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="DELETE_credesal_loan_mora_terms"/><column name="entity_name" value="credesal_loan_mora_terms"/><column name="action_name" value="DELETE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    </changeSet>
    <changeSet id="0431-4-require-daily-mora-income-account" author="credesal">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="1">SELECT COUNT(1) FROM acc_gl_account WHERE gl_code = '611001010003'</sqlCheck>
        </preConditions>
        <sql>SELECT 1;</sql>
    </changeSet>
    <changeSet id="0431-5-seed-daily-mora-charge" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_charge WHERE name = 'Interes por mora'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_charge">
            <column name="name" value="Interes por mora"/>
            <column name="currency_code" value="USD"/>
            <column name="charge_applies_to_enum" valueNumeric="1"/>
            <column name="charge_time_enum" valueNumeric="19"/>
            <column name="charge_calculation_enum" valueNumeric="1"/>
            <column name="charge_payment_mode_enum" valueNumeric="0"/>
            <column name="amount" valueNumeric="0.42"/>
            <column name="is_penalty" valueBoolean="true"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_deleted" valueBoolean="false"/>
            <column name="income_or_liability_account_id"
                    valueComputed="(SELECT id FROM acc_gl_account WHERE gl_code = '611001010003')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
