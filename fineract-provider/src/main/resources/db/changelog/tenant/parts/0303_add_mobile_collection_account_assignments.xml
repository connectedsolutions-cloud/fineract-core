<!--
    Exact Arissto Cobro Movil account-to-route membership from dbo.cuenta.
    Repayment schedules and visit dates remain native/derived Fineract data;
    this table does not alter contractual installment due dates.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0303-1-create-mobile-collection-account-assignment" author="credesal">
        <createTable tableName="credesal_mobile_collection_account_assignment">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="arissto_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="route_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_operational_client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_product_type_id" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_account_number" type="VARCHAR(40)"/>
            <column name="account_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT"/>
            <column name="savings_account_id" type="BIGINT"/>
            <column name="link_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="credesal_mobile_collection_account_assignment" baseColumnNames="route_id"
                                 constraintName="FK_cr_mc_acct_assign_route"
                                 referencedTableName="credesal_mobile_collection_route" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_mobile_collection_account_assignment" baseColumnNames="client_id"
                                 constraintName="FK_cr_mc_acct_assign_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_mobile_collection_account_assignment" baseColumnNames="loan_id"
                                 constraintName="FK_cr_mc_acct_assign_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_mobile_collection_account_assignment" baseColumnNames="savings_account_id"
                                 constraintName="FK_cr_mc_acct_assign_savings"
                                 referencedTableName="m_savings_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <addUniqueConstraint tableName="credesal_mobile_collection_account_assignment"
                             columnNames="arissto_account_id"
                             constraintName="UK_cr_mc_acct_assign_source"/>
        <addUniqueConstraint tableName="credesal_mobile_collection_account_assignment"
                             columnNames="loan_id"
                             constraintName="UK_cr_mc_acct_assign_loan"/>
        <addUniqueConstraint tableName="credesal_mobile_collection_account_assignment"
                             columnNames="savings_account_id"
                             constraintName="UK_cr_mc_acct_assign_savings"/>

        <createIndex tableName="credesal_mobile_collection_account_assignment" indexName="IX_cr_mc_acct_assign_route">
            <column name="route_id"/>
        </createIndex>
        <createIndex tableName="credesal_mobile_collection_account_assignment" indexName="IX_cr_mc_acct_assign_client">
            <column name="client_id"/>
        </createIndex>
        <createIndex tableName="credesal_mobile_collection_account_assignment" indexName="IX_cr_mc_acct_assign_status">
            <column name="link_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
