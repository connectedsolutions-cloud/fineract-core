    <!-- credesal_client_datos_personales (MySQL) -->
    <changeSet id="0248-1-mysql" author="credesal" context="mysql">
        <createTable tableName="credesal_client_datos_personales">
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="lugar_nacimiento" type="VARCHAR(255)"/>
            <column name="tipo_documento_identificacion" type="VARCHAR(100)"/>
            <column name="numero_documento_identificacion" type="VARCHAR(100)"/>
            <column name="fecha_vencimiento_documento" type="DATE"/>
            <column name="nacionalidad" type="VARCHAR(100)"/>
            <column name="profesion_documento_identificacion" type="VARCHAR(255)"/>
            <column name="ocupacion_actividad_real" type="VARCHAR(255)"/>
            <column name="direccion_domicilio" type="TEXT"/>
            <column name="tiempo_residir_anos" type="INT"/>
            <column name="tiempo_residir_meses" type="INT"/>
            <column name="municipio" type="VARCHAR(150)"/>
            <column name="departamento" type="VARCHAR(150)"/>
            <column name="pais" type="VARCHAR(150)"/>
            <column name="telefono_residencia" type="VARCHAR(50)"/>
            <column name="sabe_firmar" type="boolean"/>
            <column name="hijos" type="INT"/>
            <column name="nivel_educativo" type="VARCHAR(150)"/>
            <column name="es_contribuyente_fiscal" type="boolean"/>
            <column name="es_ciudadano_estadounidense" type="boolean"/>
            <column name="cliente_recibe_remesas" type="boolean"/>
            <column name="origen_remesas" type="VARCHAR(255)"/>
            <column name="pais_origen_remesas" type="VARCHAR(150)"/>
            <column name="telefono_lugar_trabajo" type="VARCHAR(50)"/>
            <column name="propiedad_vivienda" type="VARCHAR(100)"/>
            <column name="nombre_conyuge" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_client_datos_personales" baseColumnNames="client_id"
                                 constraintName="FK_credesal_datos_personales_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

