<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0318-1-correct-arissto-office-2-opening-date" author="credesal">
        <!-- MARK_RAN: Credesal office 2 only. Fresh tenants may not contain it. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_office WHERE id = 2 AND opening_date = '2024-12-11'
            </sqlCheck>
        </preConditions>
        <comment>
            Correct office 2's opening date to the earliest independently evidenced Arissto activity.
            Client/application records begin on 2024-11-27, accounting begins on 2024-11-28, and loan
            disbursements begin on 2024-11-30. Existing imported clients are reconciled to their exact
            AFI_SOCIO.FECHA_REGISTRO dates by the clients sync service after this migration runs.
        </comment>
        <update tableName="m_office">
            <column name="opening_date" valueDate="2024-11-27"/>
            <where>id = 2 AND opening_date = '2024-12-11'</where>
        </update>
        <!-- Restoring the unsupported later date would invalidate historical clients and loans. -->
        <rollback/>
    </changeSet>

</databaseChangeLog>
