<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0344-1-add-loan-freeze-current-state" author="credesal">
        <addColumn tableName="m_loan">
            <column name="is_frozen" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="frozen_on" type="DATE"/>
            <column name="freeze_reason" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="0344-2-add-loan-freeze-history" author="credesal">
        <createTable tableName="m_loan_freeze_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="action_enum" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="source_event_external_id" type="VARCHAR(100)"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="m_loan_freeze_history" baseColumnNames="loan_id"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 constraintName="fk_loan_freeze_history_loan" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_loan_freeze_history" baseColumnNames="created_by"
                                 referencedTableName="m_appuser" referencedColumnNames="id"
                                 constraintName="fk_loan_freeze_history_created_by" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_loan_freeze_history" baseColumnNames="last_modified_by"
                                 referencedTableName="m_appuser" referencedColumnNames="id"
                                 constraintName="fk_loan_freeze_history_modified_by" onDelete="RESTRICT"/>
        <addUniqueConstraint tableName="m_loan_freeze_history" columnNames="source_event_external_id"
                             constraintName="uq_loan_freeze_history_source_event"/>
        <createIndex tableName="m_loan_freeze_history" indexName="idx_loan_freeze_history_loan_date">
            <column name="loan_id"/>
            <column name="effective_date"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0344-3-add-loan-freeze-history-audit-dates" author="credesal" context="mysql">
        <addColumn tableName="m_loan_freeze_history">
            <column name="created_on_utc" type="DATETIME(6)"><constraints nullable="false"/></column>
            <column name="last_modified_on_utc" type="DATETIME(6)"><constraints nullable="false"/></column>
        </addColumn>
    </changeSet>

    <changeSet id="0344-3-add-loan-freeze-history-audit-dates" author="credesal" context="postgresql">
        <addColumn tableName="m_loan_freeze_history">
            <column name="created_on_utc" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="last_modified_on_utc" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </addColumn>
    </changeSet>

    <changeSet id="0344-4-add-freeze-loan-permission" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'FREEZE_LOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="FREEZE_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="FREEZE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="0344-5-add-unfreeze-loan-permission" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'UNFREEZE_LOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="UNFREEZE_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="UNFREEZE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
