<!--
    Arissto savings-migration support.

    Native products, accounts, transactions, interest accruals, tax entries,
    and accounting remain in Fineract core and must be created through
    supported APIs/jobs. These tables retain only migration provenance that
    the native schema cannot express: cutoff state, source joint ownership,
    and durable source-event-to-native-transaction identity.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0288-1-create-savings-migration-account" author="credesal">
        <createTable tableName="credesal_savings_migration_account">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="source_system" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="source_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="VARCHAR(64)"/>
            <column name="run_id" type="VARCHAR(64)"/>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="deposit_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_company_id" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_branch_id" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_account_id" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_account_number" type="VARCHAR(10)"/>
            <column name="arissto_numeric_id" type="INTEGER"/>
            <column name="arissto_line_id" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="source_status" type="VARCHAR(1)"/>
            <column name="capitalization_destination_source_key" type="VARCHAR(500)"/>
            <column name="source_owner_count" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_opened_on" type="DATE"/>
            <column name="source_matures_on" type="DATE"/>
            <column name="cutoff_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="accrued_interest_exact" type="DECIMAL(20,8)"/>
            <column name="accrued_interest_accounting" type="DECIMAL(20,2)"/>
            <column name="next_interest_posting_date" type="DATE"/>
            <column name="migration_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="error_code" type="VARCHAR(128)"/>
            <column name="applied_at" type="DATETIME"/>
            <column name="reconciled_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_account" baseColumnNames="client_id"
                                 constraintName="FK_cr_sav_mig_account_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_account" baseColumnNames="savings_account_id"
                                 constraintName="FK_cr_sav_mig_account_savings"
                                 referencedTableName="m_savings_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addUniqueConstraint tableName="credesal_savings_migration_account"
                             columnNames="source_system,source_key"
                             constraintName="UK_cr_sav_mig_account_source"/>
        <addUniqueConstraint tableName="credesal_savings_migration_account"
                             columnNames="savings_account_id"
                             constraintName="UK_cr_sav_mig_account_target"/>
        <createIndex tableName="credesal_savings_migration_account" indexName="IX_cr_sav_mig_account_client">
            <column name="client_id"/>
        </createIndex>
        <createIndex tableName="credesal_savings_migration_account" indexName="IX_cr_sav_mig_account_status">
            <column name="migration_status"/>
        </createIndex>
    </changeSet>

    <changeSet id="0288-2-create-savings-migration-owner" author="credesal">
        <createTable tableName="credesal_savings_migration_owner">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="migration_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_system" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="source_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="arissto_owner_id" type="VARCHAR(5)"/>
            <column name="is_native_owner" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_owner" baseColumnNames="migration_account_id"
                                 constraintName="FK_cr_sav_mig_owner_account"
                                 referencedTableName="credesal_savings_migration_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_owner" baseColumnNames="client_id"
                                 constraintName="FK_cr_sav_mig_owner_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addUniqueConstraint tableName="credesal_savings_migration_owner"
                             columnNames="source_system,source_key"
                             constraintName="UK_cr_sav_mig_owner_source"/>
        <createIndex tableName="credesal_savings_migration_owner" indexName="IX_cr_sav_mig_owner_account">
            <column name="migration_account_id"/>
        </createIndex>
        <createIndex tableName="credesal_savings_migration_owner" indexName="IX_cr_sav_mig_owner_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0288-3-create-savings-native-event-map" author="credesal">
        <createTable tableName="credesal_savings_native_event_map">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="migration_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_system" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_table" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="source_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="related_source_key" type="VARCHAR(500)"/>
            <column name="source_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="VARCHAR(64)"/>
            <column name="run_id" type="VARCHAR(64)"/>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="savings_transaction_id" type="BIGINT"/>
            <column name="event_kind" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="event_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="event_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(20,8)">
                <constraints nullable="false"/>
            </column>
            <column name="is_reversal" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="error_code" type="VARCHAR(128)"/>
            <column name="applied_at" type="DATETIME"/>
            <column name="reconciled_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_savings_native_event_map" baseColumnNames="migration_account_id"
                                 constraintName="FK_cr_sav_event_mig_account"
                                 referencedTableName="credesal_savings_migration_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_native_event_map" baseColumnNames="savings_account_id"
                                 constraintName="FK_cr_sav_event_account"
                                 referencedTableName="m_savings_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_native_event_map" baseColumnNames="savings_transaction_id"
                                 constraintName="FK_cr_sav_event_transaction"
                                 referencedTableName="m_savings_account_transaction" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addUniqueConstraint tableName="credesal_savings_native_event_map"
                             columnNames="source_system,source_table,source_key"
                             constraintName="UK_cr_sav_event_source"/>
        <addUniqueConstraint tableName="credesal_savings_native_event_map"
                             columnNames="savings_transaction_id"
                             constraintName="UK_cr_sav_event_transaction"/>
        <createIndex tableName="credesal_savings_native_event_map" indexName="IX_cr_sav_event_account">
            <column name="savings_account_id"/>
        </createIndex>
        <createIndex tableName="credesal_savings_native_event_map" indexName="IX_cr_sav_event_status">
            <column name="event_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
