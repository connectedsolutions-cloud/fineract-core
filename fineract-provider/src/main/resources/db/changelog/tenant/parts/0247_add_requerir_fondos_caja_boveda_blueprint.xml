<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Blueprint: cashier requests funds from vault (manager approves single step) -->
    <changeSet id="0247-add-requerir-fondos-caja-boveda-blueprint" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_pending_flow_blueprint WHERE name = 'requerir-fondos-caja-boveda'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_pending_flow_blueprint">
            <column name="status" value="active"/>
            <column name="name" value="requerir-fondos-caja-boveda"/>
            <column name="version" value="1.0"/>
            <column name="last_step_name" value="requerir-fondos"/>
            <column name="steps" value='[{"order":1,"name":"requerir-fondos","description":"Approve vault-to-cashier allocation","reference_type":"request","reference_fields":[{"key":"cashierId","type":"long","description":"Cashier requesting funds"},{"key":"responsable_user","type":"long","description":"User responsible for approving"},{"key":"amount","type":"string","description":"Amount to allocate (decimal as string)"},{"key":"currencyCode","type":"string","description":"Currency code e.g. MXN"}]}]'/>
        </insert>
    </changeSet>

</databaseChangeLog>
