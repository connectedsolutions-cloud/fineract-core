<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    
    <!-- Update "Increase COB Date by 1 day" cron expression to run 30 minutes after midnight -->
    <changeSet author="fineract" id="1">
        <update tableName="job">
            <column name="cron_expression" value="0 30 0 1/1 * ? *"/>
            <where>name='Increase COB Date by 1 day'</where>
        </update>
    </changeSet>
    
    <!-- Activate "Loan COB" job -->
    <changeSet author="fineract" id="2">
        <update tableName="job">
            <column name="is_active" valueBoolean="true"/>
            <where>name='Loan COB'</where>
        </update>
    </changeSet>
    
    <!-- Activate "Increase COB Date by 1 day" job -->
    <changeSet author="fineract" id="3">
        <update tableName="job">
            <column name="is_active" valueBoolean="true"/>
            <where>name='Increase COB Date by 1 day'</where>
        </update>
    </changeSet>
    
</databaseChangeLog>


