<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0345-1-add-source-exact-collateral-attach-permission" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'SOURCEEXACTATTACH_LOAN_COLLATERAL_PRODUCT'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="SOURCEEXACTATTACH_LOAN_COLLATERAL_PRODUCT"/>
            <column name="entity_name" value="LOAN_COLLATERAL_PRODUCT"/>
            <column name="action_name" value="SOURCEEXACTATTACH"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
