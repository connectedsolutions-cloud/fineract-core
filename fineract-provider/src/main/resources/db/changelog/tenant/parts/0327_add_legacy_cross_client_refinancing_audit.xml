<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0327-1-add-legacy-cross-client-refinancing-audit" author="credesal">
        <addColumn tableName="m_loan_refinancing_settlement">
            <column name="legacy_cross_client" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_basis" type="VARCHAR(50)"/>
            <column name="source_system" type="VARCHAR(30)"/>
            <column name="source_liquidation_id" type="VARCHAR(100)"/>
            <column name="source_payoff_movement_id" type="VARCHAR(100)"/>
            <column name="source_operator_id" type="VARCHAR(100)"/>
            <column name="source_payoff_date" type="DATE"/>
            <column name="predecessor_client_id" type="BIGINT"/>
            <column name="successor_client_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="m_loan_refinancing_settlement" baseColumnNames="predecessor_client_id"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 constraintName="fk_refinancing_settlement_predecessor_client"/>
        <addForeignKeyConstraint baseTableName="m_loan_refinancing_settlement" baseColumnNames="successor_client_id"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 constraintName="fk_refinancing_settlement_successor_client"/>
        <createIndex tableName="m_loan_refinancing_settlement" indexName="idx_refinancing_legacy_cross_client">
            <column name="legacy_cross_client"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
