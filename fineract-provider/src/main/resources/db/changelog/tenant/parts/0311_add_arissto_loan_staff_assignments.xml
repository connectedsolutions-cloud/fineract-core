<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0311-1-create-arissto-loan-staff-assignments" author="credesal">
        <createTable tableName="credesal_loan_staff_assignment">
            <column name="loan_id" type="BIGINT"><constraints nullable="false" primaryKey="true"/></column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="arissto_company_id" type="VARCHAR(3)"/>
            <column name="arissto_promoter_person_id" type="VARCHAR(5)"/>
            <column name="arissto_account_executive_person_id" type="VARCHAR(5)"/>
            <column name="arissto_collections_manager_person_id" type="VARCHAR(5)"/>
            <column name="promoter_staff_id" type="BIGINT"/>
            <column name="account_executive_staff_id" type="BIGINT"/>
            <column name="collections_manager_staff_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_loan_staff_assignment" baseColumnNames="loan_id"
                                 constraintName="FK_credesal_loan_staff_assignment_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_loan_staff_assignment" baseColumnNames="client_id"
                                 constraintName="FK_credesal_loan_staff_assignment_client"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_loan_staff_assignment" baseColumnNames="promoter_staff_id"
                                 constraintName="FK_credesal_loan_staff_assignment_promoter"
                                 referencedTableName="m_staff" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_loan_staff_assignment" baseColumnNames="account_executive_staff_id"
                                 constraintName="FK_credesal_loan_staff_assignment_executive"
                                 referencedTableName="m_staff" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_loan_staff_assignment" baseColumnNames="collections_manager_staff_id"
                                 constraintName="FK_credesal_loan_staff_assignment_collections"
                                 referencedTableName="m_staff" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <createIndex tableName="credesal_loan_staff_assignment" indexName="IX_credesal_loan_staff_assignment_client">
            <column name="client_id"/>
        </createIndex>
        <createIndex tableName="credesal_loan_staff_assignment" indexName="IX_credesal_loan_staff_assignment_promoter">
            <column name="promoter_staff_id"/>
        </createIndex>
        <createIndex tableName="credesal_loan_staff_assignment" indexName="IX_credesal_loan_staff_assignment_executive">
            <column name="account_executive_staff_id"/>
        </createIndex>
        <createIndex tableName="credesal_loan_staff_assignment" indexName="IX_credesal_loan_staff_assignment_collections">
            <column name="collections_manager_staff_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0311-2-register-arissto-loan-staff-assignments" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM x_registered_table WHERE registered_table_name = 'credesal_loan_staff_assignment'</sqlCheck>
        </preConditions>
        <insert tableName="x_registered_table">
            <column name="registered_table_name" value="credesal_loan_staff_assignment"/>
            <column name="application_table_name" value="m_loan"/>
            <column name="category" valueNumeric="100"/>
        </insert>
    </changeSet>

    <changeSet id="0311-3-loan-staff-assignment-permissions" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'CREATE_credesal_loan_staff_assignment'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="CREATE_credesal_loan_staff_assignment"/><column name="entity_name" value="credesal_loan_staff_assignment"/><column name="action_name" value="CREATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="READ_credesal_loan_staff_assignment"/><column name="entity_name" value="credesal_loan_staff_assignment"/><column name="action_name" value="READ"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="UPDATE_credesal_loan_staff_assignment"/><column name="entity_name" value="credesal_loan_staff_assignment"/><column name="action_name" value="UPDATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
        <insert tableName="m_permission"><column name="grouping" value="datatable"/><column name="code" value="DELETE_credesal_loan_staff_assignment"/><column name="entity_name" value="credesal_loan_staff_assignment"/><column name="action_name" value="DELETE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    </changeSet>

</databaseChangeLog>
