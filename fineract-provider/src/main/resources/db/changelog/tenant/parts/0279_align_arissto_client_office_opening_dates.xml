<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0279-1-align-arissto-client-office-opening-dates" author="credesal">
        <!-- MARK_RAN: Credesal production offices only. Fresh tenants (e.g. sandbox) have Head Office only. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_office WHERE id = 1
            </sqlCheck>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_office WHERE id = 2
            </sqlCheck>
            <sqlCheck expectedResult="2">
                SELECT COUNT(*)
                FROM m_office
                WHERE (id = 1 AND opening_date IN ('2022-12-10', '2024-03-01'))
                   OR (id = 2 AND opening_date IN ('2024-12-11', '2025-01-01'))
            </sqlCheck>
        </preConditions>
        <comment>
            Align the two Fineract offices used by the Arissto client migration with their reviewed historical
            opening dates. These dates are activation floors for imported clients. The updates match only the
            known production drift values and are no-ops in environments that are already aligned.
        </comment>
        <sql><![CDATA[
            UPDATE m_office
            SET opening_date = '2022-12-10'
            WHERE id = 1 AND opening_date = '2024-03-01';

            UPDATE m_office
            SET opening_date = '2024-12-11'
            WHERE id = 2 AND opening_date = '2025-01-01';
        ]]></sql>
        <!--
            No automatic rollback: an already-correct environment executes this changeset as a no-op, so a
            generic rollback could incorrectly introduce the production drift values there.
        -->
        <rollback/>
    </changeSet>

</databaseChangeLog>
