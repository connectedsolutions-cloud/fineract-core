<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="0349-1-native-share-yield" author="credesal">
        <createTable tableName="m_share_product_yield_config">
            <column name="product_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="annual_rate" type="DECIMAL(10,6)">
                <constraints nullable="false"/>
            </column>
            <column name="accrual_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="expense_gl_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="payable_gl_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_share_product_yield_config" baseColumnNames="product_id"
                                 constraintName="FK_share_yield_config_product" referencedTableName="m_share_product"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_share_product_yield_config" baseColumnNames="expense_gl_account_id"
                                 constraintName="FK_share_yield_config_expense" referencedTableName="acc_gl_account"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_share_product_yield_config" baseColumnNames="payable_gl_account_id"
                                 constraintName="FK_share_yield_config_payable" referencedTableName="acc_gl_account"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>

        <createTable tableName="m_share_account_yield_accrual">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="share_account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="share_transaction_id" type="BIGINT"><constraints nullable="false" unique="true"/></column>
            <column name="accrual_date" type="DATE"><constraints nullable="false"/></column>
            <column name="entry_type" type="VARCHAR(20)" defaultValue="ACCRUAL"><constraints nullable="false"/></column>
            <column name="base_amount" type="DECIMAL(19,6)"><constraints nullable="false"/></column>
            <column name="annual_rate" type="DECIMAL(10,6)"><constraints nullable="false"/></column>
            <column name="day_count_basis" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="accrued_amount" type="DECIMAL(19,8)"><constraints nullable="false"/></column>
            <column name="booked_amount" type="DECIMAL(19,6)"><constraints nullable="false"/></column>
            <column name="source_reference" type="VARCHAR(100)"/>
            <column name="imported" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="m_share_account_yield_accrual" indexName="IDX_share_yield_account_date">
            <column name="share_account_id"/>
            <column name="accrual_date"/>
        </createIndex>
        <addUniqueConstraint tableName="m_share_account_yield_accrual"
                             columnNames="source_reference" constraintName="UK_share_yield_source_reference"/>
        <addForeignKeyConstraint baseTableName="m_share_account_yield_accrual" baseColumnNames="share_account_id"
                                 constraintName="FK_share_yield_accrual_account" referencedTableName="m_share_account"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_share_account_yield_accrual" baseColumnNames="share_transaction_id"
                                 constraintName="FK_share_yield_accrual_transaction" referencedTableName="m_share_account_transactions"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>

        <createTable tableName="m_share_account_yield_settlement">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="share_account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="savings_transaction_id" type="BIGINT"><constraints nullable="false" unique="true"/></column>
            <column name="settlement_date" type="DATE"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(19,6)"><constraints nullable="false"/></column>
            <column name="reference" type="VARCHAR(100)"/>
        </createTable>
        <addUniqueConstraint tableName="m_share_account_yield_settlement" columnNames="reference"
                             constraintName="UK_share_yield_settlement_reference"/>
        <addForeignKeyConstraint baseTableName="m_share_account_yield_settlement" baseColumnNames="share_account_id"
                                 constraintName="FK_share_yield_settlement_account" referencedTableName="m_share_account"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_share_account_yield_settlement" baseColumnNames="savings_transaction_id"
                                 constraintName="FK_share_yield_settlement_savings_tx" referencedTableName="m_savings_account_transaction"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="0349-2-native-share-yield-permissions" author="credesal">
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/><column name="code" value="CREATE_YIELDCONFIG_SHAREPRODUCT"/>
            <column name="entity_name" value="SHAREPRODUCT"/><column name="action_name" value="CREATE_YIELDCONFIG"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_share"/><column name="code" value="SOURCEEXACTYIELDACCRUAL_SHAREACCOUNT"/>
            <column name="entity_name" value="SHAREACCOUNT"/><column name="action_name" value="SOURCEEXACTYIELDACCRUAL"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_share"/><column name="code" value="SETTLEYIELD_SHAREACCOUNT"/>
            <column name="entity_name" value="SHAREACCOUNT"/><column name="action_name" value="SETTLEYIELD"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="0349-3-native-share-yield-job" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from job where name = 'Accrue Share Yield'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Accrue Share Yield"/>
            <column name="display_name" value="Accrue Share Yield"/>
            <column name="cron_expression" value="0 15 0 * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Accrue Share YieldJobDetail1 _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="SH_YIELD"/>
        </insert>
    </changeSet>
</databaseChangeLog>
