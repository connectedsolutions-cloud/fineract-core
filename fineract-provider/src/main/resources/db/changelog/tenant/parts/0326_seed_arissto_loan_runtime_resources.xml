<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0326-0-require-debt-insurance-liability-account" author="credesal">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1) FROM acc_gl_account WHERE gl_code = '222007020102'
            </sqlCheck>
        </preConditions>
        <sql>SELECT 1;</sql>
    </changeSet>

    <changeSet id="0326-1-seed-arissto-recurring-debt-insurance-charge" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1) FROM acc_gl_account WHERE gl_code = '222007020102'
            </sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_charge
                 WHERE charge_applies_to_enum = 1
                   AND charge_time_enum = 8
                   AND charge_calculation_enum = 8
                   AND amount = 0.06
                   AND income_or_liability_account_id =
                       (SELECT id FROM acc_gl_account WHERE gl_code = '222007020102')
            </sqlCheck>
        </preConditions>
        <insert tableName="m_charge">
            <column name="name" value="Arissto recurring debt insurance 0.06%"/>
            <column name="currency_code" value="USD"/>
            <column name="charge_applies_to_enum" valueNumeric="1"/>
            <column name="charge_time_enum" valueNumeric="8"/>
            <column name="charge_calculation_enum" valueNumeric="8"/>
            <column name="charge_payment_mode_enum" valueNumeric="0"/>
            <column name="amount" valueNumeric="0.06"/>
            <column name="is_penalty" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_deleted" valueBoolean="false"/>
            <column name="income_or_liability_account_id"
                    valueComputed="(SELECT id FROM acc_gl_account WHERE gl_code = '222007020102')"/>
        </insert>
    </changeSet>

    <changeSet id="0326-2-seed-cobro-movil-payment-type" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_payment_type WHERE value = 'Cobro Móvil'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_payment_type">
            <column name="value" value="Cobro Móvil"/>
            <column name="description"
                    value="Arissto system 14 loan repayment; debits cuotas pendientes de aplicar"/>
            <column name="is_cash_payment" valueBoolean="false"/>
            <column name="order_position" valueNumeric="8"/>
            <column name="code_name" value="CREDESAL_COBRO_MOVIL"/>
            <column name="is_system_defined" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
