<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0347-1-repair-loan-cob-business-step-order" author="credesal">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1)
                FROM m_batch_business_steps
                WHERE job_name = 'LOAN_CLOSE_OF_BUSINESS'
                  AND step_name = 'APPLY_DELINQUENCY_RANGE_CHARGES'
            </sqlCheck>
        </preConditions>

        <!--
            0258 placed APPLY_DELINQUENCY_RANGE_CHARGES at order 3 without
            moving the existing steps. The duplicate order prevents every
            non-closed loan from completing COB. Preserve the configured
            relative order while opening slot 3 immediately after delinquency
            classification and before repayment checks and periodic accruals.
        -->
        <update tableName="m_batch_business_steps">
            <column name="step_order" valueComputed="step_order + 1"/>
            <where>
                job_name = 'LOAN_CLOSE_OF_BUSINESS'
                AND step_name &lt;&gt; 'APPLY_DELINQUENCY_RANGE_CHARGES'
                AND step_order &gt;= 3
            </where>
        </update>
        <update tableName="m_batch_business_steps">
            <column name="step_order" valueNumeric="3"/>
            <where>
                job_name = 'LOAN_CLOSE_OF_BUSINESS'
                AND step_name = 'APPLY_DELINQUENCY_RANGE_CHARGES'
            </where>
        </update>
    </changeSet>
</databaseChangeLog>
