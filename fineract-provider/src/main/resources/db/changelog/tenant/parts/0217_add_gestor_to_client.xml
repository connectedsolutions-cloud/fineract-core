<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Add gestor_id column to m_client table -->
    <changeSet id="1" author="fineract">
        <addColumn tableName="m_client">
            <column name="gestor_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add foreign key constraint for gestor_id -->
    <changeSet id="2" author="fineract">
        <addForeignKeyConstraint baseTableName="m_client" baseColumnNames="gestor_id"
                                 constraintName="fk_m_client_gestor"
                                 referencedTableName="m_staff" referencedColumnNames="id"/>
        <createIndex indexName="idx_m_client_gestor" tableName="m_client">
            <column name="gestor_id"/>
        </createIndex>
    </changeSet>

    <!-- Add ASSIGNGESTOR_CLIENT permission -->
    <changeSet id="3" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'ASSIGNGESTOR_CLIENT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="code" value="ASSIGNGESTOR_CLIENT"/>
            <column name="action_name" value="ASSIGNGESTOR"/>
            <column name="entity_name" value="CLIENT"/>
            <column name="can_maker_checker" valueBoolean="false"/>
            <column name="grouping" value="portfolio"/>
        </insert>
    </changeSet>

    <!-- Add UNASSIGNGESTOR_CLIENT permission -->
    <changeSet id="4" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'UNASSIGNGESTOR_CLIENT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="code" value="UNASSIGNGESTOR_CLIENT"/>
            <column name="action_name" value="UNASSIGNGESTOR"/>
            <column name="entity_name" value="CLIENT"/>
            <column name="can_maker_checker" valueBoolean="false"/>
            <column name="grouping" value="portfolio"/>
        </insert>
    </changeSet>

</databaseChangeLog>

