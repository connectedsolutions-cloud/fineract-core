<?xml version="1.0" encoding="UTF-8"?>
<!--
    Preserve the one-to-many relation between an Arissto DPF position and the
    native Fineract fixed-deposit accounts created for each renewed term.

    Native deposits, interest, transfers, maturity and closure transactions
    remain in Fineract core. This table stores migration identity only.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="0300-1-create-arissto-fixed-deposit-cycle" author="credesal">
        <createTable tableName="credesal_savings_migration_cycle">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="migration_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="previous_cycle_id" type="BIGINT"/>
            <column name="source_system" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="source_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="VARCHAR(64)"/>
            <column name="run_id" type="VARCHAR(64)"/>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cycle_sequence" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="source_boundary_history_id" type="VARCHAR(10)"/>
            <column name="source_opened_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="source_matures_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="opening_inference" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="cycle_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="is_current_cycle" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="migration_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="error_code" type="VARCHAR(128)"/>
            <column name="applied_at" type="DATETIME"/>
            <column name="reconciled_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_cycle" baseColumnNames="migration_account_id"
                                 constraintName="FK_cr_sav_mig_cycle_account"
                                 referencedTableName="credesal_savings_migration_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_cycle" baseColumnNames="previous_cycle_id"
                                 constraintName="FK_cr_sav_mig_cycle_previous"
                                 referencedTableName="credesal_savings_migration_cycle" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="credesal_savings_migration_cycle" baseColumnNames="savings_account_id"
                                 constraintName="FK_cr_sav_mig_cycle_savings"
                                 referencedTableName="m_savings_account" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addUniqueConstraint tableName="credesal_savings_migration_cycle"
                             columnNames="source_system,source_key"
                             constraintName="UK_cr_sav_mig_cycle_source"/>
        <addUniqueConstraint tableName="credesal_savings_migration_cycle"
                             columnNames="savings_account_id"
                             constraintName="UK_cr_sav_mig_cycle_target"/>
        <addUniqueConstraint tableName="credesal_savings_migration_cycle"
                             columnNames="migration_account_id,cycle_sequence"
                             constraintName="UK_cr_sav_mig_cycle_sequence"/>
        <createIndex tableName="credesal_savings_migration_cycle" indexName="IX_cr_sav_mig_cycle_account">
            <column name="migration_account_id"/>
            <column name="is_current_cycle"/>
        </createIndex>
        <createIndex tableName="credesal_savings_migration_cycle" indexName="IX_cr_sav_mig_cycle_status">
            <column name="migration_status"/>
        </createIndex>
    </changeSet>

    <changeSet id="0300-2-link-savings-events-to-dpf-cycle" author="credesal">
        <addColumn tableName="credesal_savings_native_event_map">
            <column name="migration_cycle_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="credesal_savings_native_event_map" baseColumnNames="migration_cycle_id"
                                 constraintName="FK_cr_sav_event_cycle"
                                 referencedTableName="credesal_savings_migration_cycle" referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <createIndex tableName="credesal_savings_native_event_map" indexName="IX_cr_sav_event_cycle">
            <column name="migration_cycle_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
